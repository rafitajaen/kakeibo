# Localhost connection strings for `dotnet run` (not Docker)
# Copy to .env.local and adjust ports if needed

# PostgreSQL (localhost:5432 instead of postgresdb service name)
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# Redis (localhost:6379 instead of redis service name)
Redis__ConnectionString=localhost:6379,password=${REDIS_PASSWORD}

# MinIO (localhost:9000 instead of minio service name)
Storage__Endpoint=localhost:9000
Storage__AccessKey=${STORAGE_ACCESS_KEY}
Storage__SecretKey=${STORAGE_SECRET_KEY}
Storage__UseSSL=false

# ClickHouse (localhost:8123 instead of clickhouse service name)
ClickHouse__Host=localhost
ClickHouse__Port=8123
ClickHouse__Database=kakeibo

# Email Renderer (localhost:3050 instead of email-renderer service name)
EmailRenderer__BaseUrl=http://localhost:3050

# SMTP (localhost:1025 instead of mailpit service name)
Smtp__Host=localhost
Smtp__Port=1025
Smtp__From=${SMTP_FROM}

# JWT (same for all environments)
Jwt__SecretKey=${JWT_SECRET_KEY}
Jwt__Issuer=${JWT_ISSUER}
Jwt__Audience=${JWT_AUDIENCE}

# Google OAuth (optional — omit to disable Google Sign-In)
# GoogleAuth__ClientId=${GOOGLE_CLIENT_ID}
