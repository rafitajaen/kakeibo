<clickhouse>
    <!-- Development-only: Limit resource usage for local Docker -->
    <max_threads>1</max_threads>
    <max_block_size>8192</max_block_size>
    <max_insert_block_size>8192</max_insert_block_size>

    <!-- Disable parallel parsing/formatting -->
    <max_parsing_threads>1</max_parsing_threads>
    <max_output_format_threads>1</max_output_format_threads>

    <!-- Limit mark cache to 500MB -->
    <mark_cache_size>524288000</mark_cache_size>
</clickhouse>
