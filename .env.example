# =============================================================================
# Kakeibo — Environment Variables
# Copy this file to .env and fill in all empty secret values.
# Never commit .env to version control.
# =============================================================================

# PostgreSQL — Main relational database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kakeibo

# Redis — Distributed cache
REDIS_PASSWORD=changeme

# RustFS — S3-compatible object storage (alpha.83)
# Access key ID (public identifier, not a secret)
STORAGE_ACCESS_KEY=kakeibo
# Generate with: openssl rand -base64 32
STORAGE_SECRET_KEY=changeme

# JWT Authentication — signing key must be at least 32 characters
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=changeme
# Identifies who issued the token (API service name)
JWT_ISSUER=kakeibo-api
# Identifies the intended recipient of the token (web app)
JWT_AUDIENCE=kakeibo-app

# SMTP — Default sender address for transactional emails
SMTP_FROM=noreply@kakeibo.local

# Admin seeding — creates the first admin account at startup.
# Both variables must be set for seeding to run. If either is missing or empty,
# the seeder is silently skipped — safe to deploy without pre-seeding.
# Seeding only runs once: if an admin already exists in the database it is skipped.
# The account is created with Role=Admin, IsVerified=true, Currency=EUR.
# Recommendation: remove both variables from .env after the first successful deploy.

# ADMIN_EMAIL=admin@kakeibo.local
# ADMIN_PASSWORD=changeme
