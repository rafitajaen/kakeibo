# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=kakeibo

# Redis
REDIS_PASSWORD=your-redis-password-here

# RustFS (S3-compatible storage)
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=your-storage-secret-key-here

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars-here
JWT_ISSUER=kakeibo-api
JWT_AUDIENCE=kakeibo-app

# Email (SMTP)
SMTP_FROM=noreply@kakeibo.local
SMTP_HOST=mailpit
SMTP_PORT=1025

# Email Renderer
EMAIL_RENDERER_URL=http://email-renderer:3050
